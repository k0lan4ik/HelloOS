{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Current FASM File", 
            "type": "shell",
            "command": "${config:fasm.assemblerPath}\\FASM.exe",
            "args": [
                "${workspaceFolder}\\KERNEL_X32\\KERNEL.asm"
            ],
            "group": {
                "kind": "build",
                
            },
            "problemMatcher": [],
            "options": {
                "env": {
                    "FASM": "${config:fasm.assemblerPath}",
                    "INCLUDE": "${config:fasm.includePath}"
                }
            }
        },
        {
            "label": "Compile Make FASM File", 
            "type": "shell",
            "command": "${config:fasm.assemblerPath}\\FASM.exe",
            "args": [
                "${workspaceFolder}\\MakeImage.asm" 
            ],
            "problemMatcher": [],
            "options": {
                "env": {
                    "FASM": "${config:fasm.assemblerPath}",
                    "INCLUDE": "${config:fasm.includePath}"
                }
            }
        },
        {
            "label": "Build All FASM (Default)", 
            "dependsOn": [
                "Compile Current FASM File", 
                "Compile Make FASM File" 
            ],
            "group": {
                "kind": "build",
                "isDefault": true 
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ],

   "activeFilePath": "${file}",
    "executionFilePath": "",
     "debuggerFilePath": ""
}